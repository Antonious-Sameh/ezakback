# System 5 backend — environment variables
# Copy this file to `.env` for local development. Never commit the real `.env`.
# On Vercel, set these as Project Environment Variables instead of a file.
# See README.md for the full deployment checklist.

NODE_ENV=development
PORT=4100
LOG_LEVEL=info

# Comma-separated list of origins allowed to call this API. Set this to
# System 5's own frontend URL(s) once deployed, e.g.:
# CORS_ORIGINS=https://system5-frontend.vercel.app
CORS_ORIGINS=

# ── Shops 1-4 connection details ────────────────────────────────────────
# For each shop: its own backend's base URL (including /api), and the
# ADMIN_READONLY_KEY generated for it when /api/admin/* was added there —
# NOT its JWT secret, NOT its MongoDB URI, NOT its Cloudinary key. These two
# values are the only credentials System 5 ever holds for a shop.
#
# A shop must have BOTH values set, or NEITHER — the server refuses to
# start if only one of a pair is set (almost always a copy-paste mistake).
# Leave a shop's pair both empty to simply not include it yet.
#
# SHOP{N}_NAME is just a display label used in the dashboard; defaults to
# "المحل الأول" / "الثاني" / etc. if left unset.

SHOP1_NAME=
SHOP1_API_URL=https://system1-backend.vercel.app/api
SHOP1_ADMIN_KEY=

SHOP2_NAME=
SHOP2_API_URL=https://system2-backend.vercel.app/api
SHOP2_ADMIN_KEY=

SHOP3_NAME=
SHOP3_API_URL=https://system3-backend.vercel.app/api
SHOP3_ADMIN_KEY=

SHOP4_NAME=
SHOP4_API_URL=https://system4-backend.vercel.app/api
SHOP4_ADMIN_KEY=

# Milliseconds to wait for one shop's backend before giving up on it (a
# request to /api/shops or a comparison report queries all four in
# parallel — one slow shop must not stall the rest).
SHOP_REQUEST_TIMEOUT_MS=8000

# ── System 5's own owner login ──────────────────────────────────────────
# One account only (the business owner) — no database needed for it.
# Generate the hash with:
#   npm run hash-password -- "your-password-here"
# then paste the printed line below. Leave empty to keep login disabled
# (POST /api/auth/login returns 503 until this is set).
OWNER_PASSWORD_HASH=

# A long random secret, generated the same way as Shops 1-4's
# JWT_ACCESS_SECRET — completely separate value, never reused across
# systems:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
OWNER_JWT_SECRET=

# How long a login session stays valid before the owner has to log in again.
OWNER_TOKEN_TTL_HOURS=12
